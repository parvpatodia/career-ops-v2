{
  "name": "career-ops",
  "version": "2.0.0",
  "type": "module",
  "description": "Autonomous job application system with a verify-or-abstain submission gate",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "scan": "tsx src/scanner/index.ts",
    "pipeline": "tsx src/pipeline/index.ts",
    "apply": "tsx src/applier/index.ts",
    "run": "tsx src/orchestrator/index.ts",
    "source": "tsx src/orchestrator/source.ts",
    "audit:answers": "tsx scripts/audit-answers.ts",
    "demo": "tsx scripts/demo.ts",
    "demo:workday": "tsx scripts/demo-workday.ts",
    "demo:autopilot": "tsx scripts/demo-autopilot.ts",
    "demo:tailor": "tsx scripts/demo-tailor.ts",
    "demo:integration": "tsx scripts/demo-integration.ts",
    "migrate": "tsx scripts/migrate-legacy.ts",
    "expire": "tsx scripts/expire-stale.ts",
    "dashboard": "tsx scripts/dashboard.ts",
    "login": "tsx scripts/login.ts",
    "pdf": "node generate-pdf.mjs"
  },
  "keywords": [
    "ai",
    "job-search",
    "claude-code",
    "career",
    "automation"
  ],
  "author": "Parv Patodia",
  "repository": {
    "type": "git",
    "url": "https://github.com/parvpatodia/career-ops"
  },
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "dotenv": "^16.4.5",
    "js-yaml": "^4.1.1",
    "playwright": "^1.58.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.19.43",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1"
  }
}
