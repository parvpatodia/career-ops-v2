{
  "name": "career-ops",
  "version": "2.0.0",
  "type": "module",
  "description": "Autonomous job application system with a verify-or-abstain submission gate",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "scan": "tsx src/scanner/index.ts",
    "pipeline": "tsx src/pipeline/index.ts",
    "apply": "tsx src/applier/index.ts",
    "run": "tsx src/orchestrator/index.ts",
    "source": "tsx src/orchestrator/source.ts",
    "watch": "tsx src/watch/index.ts",
    "ui": "tsx src/ui/server.ts",
    "audit:answers": "tsx scripts/audit-answers.ts",
    "inbox": "tsx src/inbox/index.ts",
    "inbox:mac": "tsx src/inbox/macMail.ts",
    "inbox:gmail": "tsx src/inbox/gmailInbox.ts",
    "outreach:account": "tsx src/outreach/cli/account.ts",
    "outreach:plan": "tsx src/outreach/cli/plan.ts",
    "outreach:send": "tsx src/outreach/cli/send.ts",
    "outreach:canary": "tsx src/outreach/cli/canary.ts",
    "outreach:linkedin": "tsx src/outreach/cli/linkedinRoles.ts",
    "outreach:suppress": "tsx scripts/outreach-suppress.ts",
    "tailor:fresh": "tsx src/tailor/cli/tailorFresh.ts",
    "outreach:daily": "npm run outreach:plan && npm run outreach:send",
    "mcp": "tsx src/mcp/server.ts",
    "demo": "tsx scripts/demo.ts",
    "demo:workday": "tsx scripts/demo-workday.ts",
    "demo:autopilot": "tsx scripts/demo-autopilot.ts",
    "demo:tailor": "tsx scripts/demo-tailor.ts",
    "demo:integration": "tsx scripts/demo-integration.ts",
    "demo:captcha": "tsx scripts/demo-captcha.ts",
    "migrate": "tsx scripts/migrate-legacy.ts",
    "expire": "tsx scripts/expire-stale.ts",
    "dashboard": "tsx scripts/dashboard.ts",
    "login": "tsx scripts/login.ts",
    "pdf": "node generate-pdf.mjs",
    "secrets": "tsx src/secrets/index.ts"
  },
  "keywords": [
    "ai",
    "job-search",
    "claude-code",
    "career",
    "automation"
  ],
  "author": "Parv Patodia",
  "repository": {
    "type": "git",
    "url": "https://github.com/parvpatodia/career-ops"
  },
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^16.4.5",
    "imapflow": "^1.4.1",
    "js-yaml": "^4.1.1",
    "mailparser": "^3.9.14",
    "nodemailer": "^9.0.0",
    "playwright": "^1.58.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1"
  }
}
