.resolved-prompt-*
node_modules/
# Write-only audit/efficiency logs; nothing reads them back. Every test and
# every CLI run appends here, which dirtied the tracked tree (LESSONS 2026-06-12).
# Scanner-cache *.json in this dir stay tracked (the pipeline reads them).
data/daily_log/*-ops.jsonl
data/daily_log/token-usage.jsonl

# OS
.DS_Store
*.mov
*.mp4

# Claude Code local
.claude/settings.local.json
.claude/memory/
career-dashboard

# Secrets and personal data (2026-06-10 audit: live token + password were exposed)
.env
.env.*
.browser-profile/
.playwright-mcp/
# Encrypted secrets vault (SecretVault) + its key — NEVER commit
config/credentials.enc
.vault.key
data/applications.json
cv/
files.zip
files_extracted/
*.png
# Outreach holds third-party contact emails (other people's PII) and Parv's
# draft content; keep all of it out of git, log included.
data/outreach.jsonl
data/outreach.jsonl.lock
data/outreach/

# Watcher runtime state / caches (derived; never source)
data/new-jobs.json
data/watch-seen.json
data/jd-cache.json

# Personal job-search data (2026-08-25: repo went public with 246 company names,
# 367 application outcomes, and 4.8K log lines naming Parv. History was rewritten
# with git-filter-repo. Never track these again.)
data/events.jsonl
data/applications.legacy.json
data/daily_log/*.json
data/daily_log/*.jsonl
!data/**/.gitkeep
